# Variables de entorno de The Clothes Box. Copia los nombres, define los valores en tu
# terminal (ver README, sección 7) y nunca subas un archivo .env con valores reales.
# Node 20 no lee .env por sí solo: en PowerShell usa $env:NOMBRE = "valor".

# --- Obligatorias (salvo NODE_ENV=test) ---
# Secreto para firmar los JWT. Usa un valor largo y aleatorio.
JWT_SECRET=
# Clave para cifrar datos sensibles (medidas). Si se pierde, se pierden esos datos.
DATA_ENCRYPTION_KEY=

# --- Servidor y datos ---
NODE_ENV=development
PORT=3000
# Carpeta de datos de ejecución (base, catálogo con stock, bandeja de salida). No va en git.
DATA_DIR=backend/data/runtime
APP_BASE_URL=http://localhost:3000
# Orígenes permitidos para CORS, separados por coma (sin "*"). La propia página siempre puede.
CORS_ORIGINS=http://localhost:3000
# Vida del token de sesión en horas.
JWT_TTL_HOURS=8
POLICY_VERSION=v1.0

# --- Cuentas internas: se crean al arrancar solo si el correo no existe ---
# Contraseñas de 8 caracteres o más con letras y números. Nunca las subas a git.
ADMIN_EMAIL=
ADMIN_PASSWORD=
STYLIST_EMAIL=
STYLIST_PASSWORD=
WAREHOUSE_EMAIL=
WAREHOUSE_PASSWORD=
# Contraseña del cliente demo de la semilla (demo@theclothesbox.co). Opcional.
DEMO_CLIENT_PASSWORD=

# --- Servicios externos (todos SIMULADOS por ahora) ---
PAYMENT_PROVIDER=simulated
PAYMENT_WEBHOOK_SECRET=
INVOICING_PROVIDER=simulated
SHIPPING_PROVIDER=simulated
MAIL_PROVIDER=simulated

# --- Archivos sueltos (opcional, para pruebas y scripts) ---
# TCB_DB_FILE=
# TCB_CATALOG_FILE=
# TCB_OUTBOX_FILE=
